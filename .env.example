# Copier ce fichier vers .env.local (ou .env) et renseigner les valeurs réelles.
# Ce fichier n'est jamais commité (voir .gitignore).

# ============================================================
# Instagram Analytics — Lady Socialdown
# ============================================================
WINDSOR_API_KEY=
ANTHROPIC_API_KEY=
INSTAGRAM_ACCOUNT_ID=17841446862033780
# Optionnel — date de référence du cycle J+7/15/21/30 (YYYY-MM-DD).
# Si absent, la date du premier lancement de l'app est utilisée automatiquement.
# INSTAGRAM_REFERENCE_DATE=
# Secret partagé avec Vercel Cron (voir vercel.json) pour protéger /api/instagram/cron.
# Générer une valeur aléatoire, ex. `openssl rand -hex 32`.
CRON_SECRET=

# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Clerk (authentification)
# ============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ============================================================
# Stripe
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIELLE_MONTHLY=
STRIPE_PRICE_ESSENTIELLE_ANNUAL=
STRIPE_PRICE_VIP_MONTHLY=
STRIPE_PRICE_VIP_ANNUAL=

# ============================================================
# Resend (emails transactionnels)
# ============================================================
# Nécessite un domaine d'envoi vérifié sur resend.com (ex. ladysocialdown.com)
# pour que l'email "from: Lady Socialdown <hello@ladysocialdown.com>" soit délivré.
RESEND_API_KEY=
